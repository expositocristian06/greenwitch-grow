# Copiá este archivo como ".env" (o cargá estas mismas variables en el panel
# de Vercel: Project Settings > Environment Variables) y completá con tus datos.
# NUNCA subas el archivo ".env" real a un repositorio público.

# Access Token de Mercado Pago (modo prueba primero, después el real de producción).
# Se consigue en: https://www.mercadopago.com.ar/developers/panel/app
# > Tus integraciones > (crear o abrir tu aplicación) > Credenciales de prueba / producción
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# URL pública del sitio ya desplegado (sin barra final). Dejalo vacío hasta el
# primer deploy; una vez que Vercel te dé la URL, completalo y volvé a desplegar.
SITE_URL=
